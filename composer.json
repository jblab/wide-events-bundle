{
    "name": "jblab/wide-events-bundle",
    "description": "Safe, structured canonical wide events bundle for Symfony applications.",
    "type": "symfony-bundle",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jblab\\WideEvents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jblab\\WideEvents\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "suggest": {
        "monolog/monolog": "^3.0 to provide the Monolog logger used by the Monolog emitter"
    },
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "tools:upgrade": [
            "@tools:upgrade:php-lint",
            "@tools:upgrade:php-cs-fixer",
            "@tools:upgrade:phpstan"
        ],
        "tools:upgrade:php-lint": "composer update --working-dir=.tools/php-lint --with-all-dependencies",
        "tools:upgrade:php-cs-fixer": "composer update --working-dir=.tools/php-cs-fixer --with-all-dependencies",
        "tools:upgrade:phpstan": "composer update --working-dir=.tools/phpstan --with-all-dependencies",
        "tools:run": [
            "@tools:run:php-lint",
            "@tools:run:phpstan",
            "@tools:run:php-cs-fixer"
        ],
        "tools:run:php-lint": "php .tools/php-lint/vendor/bin/parallel-lint --exclude vendor --exclude .tools .",
        "tools:run:phpstan": "php .tools/phpstan/vendor/bin/phpstan analyse --configuration=.phpstan.neon",
        "tools:run:php-cs-fixer": "php .tools/php-cs-fixer/vendor/bin/php-cs-fixer check --config=.php-cs-fixer.dist.php -vvvv",
        "tools:run:php-cs-fixer:fix": "php .tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php -vvvv"
    }
}
